# Squad sandbox — never commit real keys; copy to .env and fill in.
# Rotate keys if they were ever exposed in chat or logs.
SQUAD_SECRET_KEY=
SQUAD_PUBLIC_KEY=
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com

# Webhook verification:
# - Official Squad: header x-squad-encrypted-body = HMAC-SHA512(raw body, secret), hex uppercase.
# - Local simulate.py: header x-squad-signature = HMAC-SHA256(raw body, secret), hex lowercase.
# Set to false to reject legacy SHA256 (stricter, production-like).
SQUAD_WEBHOOK_LEGACY_SHA256=true

# After risk scoring, optionally call Squad verify API (404 / errors are swallowed).
SQUAD_VERIFY_ON_INGEST=false

# Do not enable unless you intentionally want payout calls from this app.
SQUAD_ENABLE_PAYOUT=false

# Simulated Titan platform fee on gross (Squad) amounts stored in DB (kobo).
# Net = gross − round(gross × rate). No extra Squad API; settlement is display-only.
TITAN_PLATFORM_FEE_RATE=0.05
TITAN_FEE_RECEIVER_ACCOUNT=TITAN_OPS_RESERVE

DATABASE_URL=postgresql://postgres:password@localhost:5432/squad_sentinel
REDIS_URL=redis://localhost:6379
APP_SECRET=your_random_app_secret_here

# Optional: simulate.py targets (defaults: http://localhost:8000/...).
# SIM_WEBHOOK_URL=http://localhost:8000/api/v1/webhook/squad
# SIM_STATS_URL=http://localhost:8000/api/v1/stats
